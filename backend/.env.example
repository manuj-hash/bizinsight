# Copy to backend/.env and fill in values from your Supabase project.
# Never commit backend/.env or paste secret keys into frontend files.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
PORT=3000
BUSINESS_TIME_ZONE=Asia/Kolkata

# Optional comma-separated origins for a separately hosted frontend.
# Same-origin frontend served by this Express app does not need this.
CORS_ORIGINS=
